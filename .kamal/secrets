# Secrets for Kamal. Never put real values in this file: it only says where to read them from.
# Export these in your shell (or use a password manager adapter, see `kamal secrets --help`) before deploying:
#
#   export SECRET_KEY_BASE=$(bin/rails secret)     # generate ONCE and keep it (changing it logs everyone out)
#   export ADMIN_EMAIL=you@example.com             # admin login for the operator portal (created on first seed)
#   export ADMIN_PASSWORD='a-long-password'

SECRET_KEY_BASE=$SECRET_KEY_BASE
ADMIN_EMAIL=$ADMIN_EMAIL
ADMIN_PASSWORD=$ADMIN_PASSWORD
