<main class="auth">
  <%= form_with url: password_path(params[:token]), method: :put, class: "panel trip" do |form| %>
    <h1><%= en? ? "New password" : "Nytt passord" %></h1>
    <div class="f"><%= form.label :password, a("passwordNew") %><%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %></div>
    <div class="f"><%= form.label :password_confirmation, en? ? "Repeat password" : "Gjenta passord" %><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %></div>
    <button class="btn primary" type="submit"><%= en? ? "Save" : "Lagre" %></button>
  <% end %>
</main>
